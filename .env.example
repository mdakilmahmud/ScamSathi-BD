# Copy to .env and fill in real values. Never commit .env.
GEMINI_API_KEY=your_gemini_key
# gemini-3.5-flash-lite answers in <1s per turn; gemini-3.6-flash is stronger but ~8s per turn
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated models tried only if the primary returns 404/429/5xx
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3-flash-preview
# Thinking level for Gemini 3.x models: low (fast) | high | default (model decides)
GEMINI_THINKING_LEVEL=low
VIRUSTOTAL_API_KEY=your_virustotal_key
GOOGLE_SAFE_BROWSING_KEY=your_google_key
URLHAUS_AUTH_KEY=your_urlhaus_key
DATABASE_URL=sqlite:///scamsathi.db
# Store a minimized copy of submitted content in history (true/false)
RETAIN_SUBMITTED_CONTENT=true
